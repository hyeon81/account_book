# Copy this file to .env and enter your server-side OpenAI API key.
# Never commit .env or put the key in VITE_* variables.
OPENAI_API_KEY=

# Optional model overrides used by the RAG and transaction draft APIs.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CATEGORY_MODEL=gpt-4.1-mini

# Embedding dimensions must match the configured embedding model.
OPENAI_EMBEDDING_DIMENSIONS=1536

# Local Compose database settings. Keep DATABASE_URL credentials in sync.
POSTGRES_DB=account_book
POSTGRES_USER=account_book
POSTGRES_PASSWORD=account_book_local
DATABASE_URL=postgresql://account_book:account_book_local@db:5432/account_book
# Outside Compose, set DATABASE_URL to a reachable PostgreSQL host instead of db.
